# File: example.env
# Description: Environment template for Kaskade Memory demo stack.
# Created: 2026-08-28
# Last updated: 2026-08-28

DATABASE_URL=postgresql://kaskade:kaskade@localhost:5432/kaskade
KASKADE_TIMEZONE=Europe/Berlin
KASKADE_DEMO_MODE=1
CASCADE_EOD_TZ=Europe/Berlin
CASCADE_EOD_HOUR=23
CASCADE_EOD_MINUTE=30
KASKADE_EOD_AGENT_PROVIDER=noop
# KASKADE_EOD_AGENT_CMD=your-agent --prompt-file {prompt_path}
KASKADE_EOD_AGENT_TIMEOUT_SEC=720
OPENROUTER_API_KEY=
CASCADE_SIGNIFICANCE_GATE_ENABLED=1
HIGH_PRIVACY_THRESHOLD=4
